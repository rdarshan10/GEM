# Copy to .env (in the folder you run from, or ~/.gem/.env). Real environment variables win.
# Then run the tests (pytest) or the quickstart (python -m gem.quickstart).

# --- LLM: pick one built-in backend (or add your own in gem/llm.py, make_llm) ---
# Ollama, local or Ollama Cloud (default)
GEM_LLM=ollama
GEM_MODEL=gpt-oss:120b-cloud
OLLAMA_HOST=http://localhost:11434

# Groq
# GEM_LLM=groq
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
# GROQ_REASONING_EFFORT=medium      # gpt-oss: low|medium|high · qwen3: none|default
# GROQ_MIN_INTERVAL=8               # seconds between calls on the free tier; 0 on a paid tier

# --- Jev decider (optional): cheap typed decisions, far fewer LLM calls ---
# GEM_DECIDER=jev
# TYPESAFE_API_KEY=

# --- Memory storage for the MCP server ---
# GEM_STORE=json                    # json (default) | falkor | memory
# GEM_HOME=~/.gem                   # where JSON memory files live
